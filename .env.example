# Токен від @BotFather
BOT_TOKEN=123456789:AA...

# Адміністратори бота (chat_id через кому). Інших людей додає адмін командою /invite.
# Свій chat_id бот покаже на /start
ALLOWED_CHAT_IDS=

# Тимчасова назва станції, поки бот не знайде справжню в журналі моста (або адмін не задасть /devname)
DEVICE_NAME=Станція

# Журнал(и) моста через кому — звідти береться справжня назва станції
BRIDGE_LOG_FILES=/bridge/oukitel_bridge.log

TZ_NAME=Europe/Kyiv

# MQTT-брокер, куди пише oukitel-portable-bridge
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_BASE=homeassistant/sensor/oukitel

# Пороги сповіщень
# Поріг низького заряду кожна людина обирає в боті сама (за замовчуванням 20%)
ALERT_FULL_BATTERY=100
# «Станція заряджена» знову спрацює, лише коли заряд впаде на стільки % (щоб цикли 98→100% не давали спаму)
FULL_REARM_PCT=5
# Вхід з мережі від цієї потужності (Вт) точно означає «мережа є». Прапорця мережі станція не віддає,
# тому бот ще враховує навантаження й заряд (див. CHANGELOG)
GRID_MIN_W=5
# Света нет, если входа и нагрузки нет, а заряд ниже лимита зарядки на столько % (с нагрузкой света нет сразу)
GRID_DROP_PCT=2
# Сколько секунд признаки отключения должны держаться, чтобы прислать «Світло зникло»
GRID_OFF_DEBOUNCE_S=120
ALERT_INPUT_DEBOUNCE_S=60
STALE_AFTER_S=300

# Старий файл розкладів (v1) — лише для автоматичної міграції при першому запуску
DATA_FILE=data/schedules.json
# Користувачі, ролі, станції (v2)
STORE_FILE=data/store.json
# Історія для статистики (SQLite) і скільки секунд чекати підтвердження станції після команди з «Керування»
HISTORY_FILE=data/history.db
CONTROL_TIMEOUT_S=90
