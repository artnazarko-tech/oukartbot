# Токен від @BotFather
BOT_TOKEN=123456789:AA...

# Адміністратори бота (chat_id через кому). Інших людей додає адмін командою /invite.
# Свій chat_id бот покаже на /start
ALLOWED_CHAT_IDS=

# Назва твоєї станції в боті
DEVICE_NAME=Oukitel P2001E Plus

TZ_NAME=Europe/Kyiv

# MQTT-брокер, куди пише oukitel-portable-bridge
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_BASE=homeassistant/sensor/oukitel

# Пороги сповіщень
ALERT_LOW_BATTERY=20
ALERT_FULL_BATTERY=100
ALERT_INPUT_ON_W=30
ALERT_INPUT_DEBOUNCE_S=60
STALE_AFTER_S=300

# Старий файл розкладів (v1) — лише для автоматичної міграції при першому запуску
DATA_FILE=data/schedules.json
# Користувачі, ролі, станції (v2)
STORE_FILE=data/store.json
